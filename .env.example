# two_brains configuration template
# Copy this file to .env and fill in the values.

LOG_LEVEL=INFO
MAX_ITERATIONS=3

# Where MemoryStore mirrors its state. Leave empty for in-memory only.
MEMORY_PATH=.two_brains_memory.json

# Provider selection for the two brains.
# Registered today: "deterministic" (default), "mock" (LLM path + canned JSON).
# Future: "anthropic", "openai", "local".
PLANNER_PROVIDER=deterministic
CRITIC_PROVIDER=deterministic

# LLM provider (ignored while both brains are deterministic).
# Future: "openai", "anthropic", "local".
LLM_PROVIDER=none

# Credentials / endpoints — consumed by LLM clients once they exist.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_LLM_URL=
