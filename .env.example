# two_brains configuration template — copy to .env and edit.
# The real .env is gitignored.

# ── Logging / iteration ──────────────────────────────────────────────
LOG_LEVEL=INFO
MAX_ITERATIONS=3

# ── Required for production deploy ───────────────────────────────────
# 32+ byte hex secret used to sign JWT tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=please-change-me-to-32-bytes-of-randomness-in-production

# ── Authentication ───────────────────────────────────────────────────
# When AUTH_ENABLED=false (default) anyone can reach the API. Flip to
# true to require login. First start with USE_DB=true creates admin/admin.
AUTH_ENABLED=false
AUTH_TOKEN_EXPIRE_HOURS=24

# ── Database ─────────────────────────────────────────────────────────
# Off by default → JSON file MemoryStore. Flip on to use SQLite/PostgreSQL.
USE_DB=false
DATABASE_URL=sqlite:///two_brains.db
# PostgreSQL example (matches docker-compose.yml):
# DATABASE_URL=postgresql+psycopg2://twobrains:changeme@db:5432/twobrains
POSTGRES_USER=twobrains
POSTGRES_PASSWORD=changeme
POSTGRES_DB=twobrains

# ── Memory store fallback (when USE_DB=false) ────────────────────────
MEMORY_PATH=.two_brains_memory.json

# ── Provider defaults ────────────────────────────────────────────────
# deterministic / mock / anthropic / openai
PLANNER_PROVIDER=mock
CRITIC_PROVIDER=mock
# deterministic / mock / anthropic / openai / agent / local-agent / openai-agent
EXECUTOR_PROVIDER=local-agent

# ── LLM credentials (optional — only needed for non-mock providers) ──
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-api03-...
# AGENT_MODEL=claude-sonnet-4-6
# LOCAL_LLM_URL=

# ── Agent sandbox root (per-user dirs created underneath) ────────────
AGENT_WORKSPACE=workspace

# ── Rate limits & per-user quotas ────────────────────────────────────
DAILY_TASK_QUOTA=100
RATE_LIMIT_GLOBAL=200/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_RUN=30/minute
# RATE_LIMIT_DISABLED=true     # only for local dev / tests
# QUOTA_DISABLED=true
