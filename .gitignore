# Secrets — the real .env must never be committed
.env

# Local state the CLI writes
.two_brains_memory.json
*.tmp

# Autonomous-agent runtime sandbox — where the agent writes generated
# files. Per-machine state, never source code, kept out of VCS.
workspace/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Distribution / build
build/
dist/
*.egg-info/
